<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.claude-thermos.serve</string>
	<key>ProgramArguments</key>
	<array>
		<string>__HOME__/.local/bin/uvx</string>
		<string>claude-thermos</string>
		<string>serve</string>
		<string>--port</string>
		<string>8787</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>StandardOutPath</key>
	<string>__HOME__/.claude-thermos/logs/daemon.out.log</string>
	<key>StandardErrorPath</key>
	<string>__HOME__/.claude-thermos/logs/daemon.err.log</string>
</dict>
</plist>
